rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      allow read, write: if true;

      match /players/{uid} {
        allow read, write: if true;
      }

      match /envelopeStates/{letter} {
        allow read, write: if true;
      }

      match /nairMessages/{msgId} {
        allow read, write: if true;
      }

      match /votes/{uid} {
        allow read, write: if true;
      }

      match /deductions/{uid} {
        allow read, write: if true;
      }

      match /compels/{compelId} {
        allow read, write: if true;
      }
    }
  }
}
