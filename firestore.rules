rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isHost(roomCode) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
    }

    match /rooms/{roomCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'playerCount', 'huntVialFoundBy', 'huntFileFoundBy', 'lastSealedBanner', 'lastPublishedBanner'
        ])
      );
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (
          request.auth.uid == uid || isHost(roomCode)
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == uid || isHost(roomCode)
        );
      }

      match /envelopeStates/{letter} {
        allow read: if isAuthenticated();
        allow create: if isHost(roomCode);
        allow update: if isAuthenticated() && (
          isHost(roomCode) ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'unlocked', 'unlocked_at', 'unlocked_by', 'published', 'published_by', 'published_at',
            'partner1_submitted', 'partner2_submitted', 'tier1_state', 'tier2_state', 'tier3_state',
            'tier1_published', 'tier2_published', 'tier3_published', 'tier1_sealed', 'tier2_sealed',
            'tier1_refusal', 'tier2_refusal', 'tier1_forced_open', 'tier2_forced_open'
          ])
        );
        allow delete: if isHost(roomCode);
      }

      match /votes/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == uid;
        allow delete: if isAuthenticated() && (request.auth.uid == uid || isHost(roomCode));
      }

      match /deductions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == uid;
        allow delete: if isAuthenticated() && (request.auth.uid == uid || isHost(roomCode));
      }

      match /nairMessages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isHost(roomCode);
      }

      match /compels/{compelId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isHost(roomCode);
      }
    }
  }
}
